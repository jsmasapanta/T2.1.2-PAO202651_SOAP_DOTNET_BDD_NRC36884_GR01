<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!--
      SQL Server local (instancia por defecto MSSQLSERVER) con el login monster / monster
      que crea "03. BDD\03_Crea_Login_monster.sql".
      Otras instancias: Data Source=.\SQLEXPRESS   o   Data Source=(localdb)\MSSQLLocalDB
    -->
    <add name="EurekaBank"
         connectionString="Data Source=localhost;Initial Catalog=EUREKABANK;User ID=monster;Password=monster;TrustServerCertificate=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>

  <system.serviceModel>
    <services>
      <service name="ec.edu.monster.ws.WSEureka">
        <endpoint address="" binding="basicHttpBinding"
                  bindingNamespace="http://espe.edu.ec/eureka/"
                  contract="ec.edu.monster.ws.IWSEureka" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- Publica el WSDL en .../WSEureka.svc?wsdl -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- Los errores se envían como FaultException<ErrorServicio>; no exponer detalles internos. -->
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!-- minFreeMemoryPercentageToActivateService="0": WCF arranca aunque la PC tenga poca RAM libre. -->
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" minFreeMemoryPercentageToActivateService="0" />
  </system.serviceModel>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="WSEureka.svc" />
      </files>
    </defaultDocument>
  </system.webServer>

</configuration>
