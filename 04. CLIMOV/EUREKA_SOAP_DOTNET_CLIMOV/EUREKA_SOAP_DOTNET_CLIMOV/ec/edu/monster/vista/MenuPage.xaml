<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.MenuPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Fondo}">

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,36,12,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="$ EurekaBank" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label x:Name="LblEmpleado" FontSize="13" TextColor="#D6E6F5" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Salir" Clicked="OnCerrarSesionClicked"
                    BackgroundColor="#A93226" TextColor="White" FontSize="13"
                    HeightRequest="38" Padding="14,0" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="¿Qué desea hacer?" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Texto}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="110,110" ColumnSpacing="12" RowSpacing="12">
                    <Button Grid.Row="0" Grid.Column="0" Text="≡&#10;Movimientos" Clicked="OnMovimientosClicked"
                            BackgroundColor="#0D6EFD" TextColor="White" FontSize="17" FontAttributes="Bold" CornerRadius="14" />
                    <Button Grid.Row="0" Grid.Column="1" Text="+&#10;Depósito" Clicked="OnDepositoClicked"
                            BackgroundColor="#198754" TextColor="White" FontSize="17" FontAttributes="Bold" CornerRadius="14" />
                    <Button Grid.Row="1" Grid.Column="0" Text="−&#10;Retiro" Clicked="OnRetiroClicked"
                            BackgroundColor="#C0392B" TextColor="White" FontSize="17" FontAttributes="Bold" CornerRadius="14" />
                    <Button Grid.Row="1" Grid.Column="1" Text="⇄&#10;Transferencia" Clicked="OnTransferenciaClicked"
                            BackgroundColor="#6F42C1" TextColor="White" FontSize="17" FontAttributes="Bold" CornerRadius="14" />
                </Grid>

                <Border Padding="16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Operaciones de esta sesión" FontAttributes="Bold" TextColor="{StaticResource Texto}" />
                        <VerticalStackLayout x:Name="ListaSesion" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LblServidor" FontSize="12" TextColor="{StaticResource TextoSuave}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
