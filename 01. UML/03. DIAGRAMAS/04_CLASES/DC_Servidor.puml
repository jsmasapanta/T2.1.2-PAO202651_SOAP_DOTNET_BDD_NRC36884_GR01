@startuml DC_Servidor
!include ../_estilo.iuml
title Diagrama de clases — Servidor EUREKA_SOAP_DOTNET_SERVIDOR

package "ec.edu.monster.ws" {
  interface IWSEureka <<ServiceContract>> {
    + login(usuario, clave) : Empleado
    + consultarCuenta(cuenta) : Cuenta
    + traerMovimientos(cuenta) : List<Movimiento>
    + registrarDeposito(cuenta, importe, codEmpleado) : decimal
    + registrarRetiro(cuenta, importe, codEmpleado) : decimal
    + registrarTransferencia(origen, destino, importe, codEmpleado) : decimal
  }
  class WSEureka {
    - Ejecutar<T>(operacion) : T
    - Falla(codigo, mensaje) : FaultException<ErrorServicio>
  }
}

package "ec.edu.monster.servicio" {
  class EurekaServicio <<Singleton>> {
    - {static} _instancia : Lazy<EurekaServicio>
    + {static} Instancia : EurekaServicio
    - EurekaServicio(bd)
    + Login(usuario, clave) : Empleado
    + ConsultarCuenta(cuenta) : Cuenta
    + TraerMovimientos(cuenta) : List<Movimiento>
    + RegistrarDeposito(...) : decimal
    + RegistrarRetiro(...) : decimal
    + RegistrarTransferencia(...) : decimal
    - LeerCuentaBloqueada(cn, tx, cuenta)
    - Aplicar(cn, tx, cuenta, variacion, tipo, empleado, referencia) : decimal
  }
  class ReglaNegocioException
  class Validacion <<static>>
}

package "ec.edu.monster.db" {
  class ConexionBD <<Singleton>> {
    - {static} _instancia : Lazy<ConexionBD>
    + {static} Instancia : ConexionBD
    - _cadenaConexion : string
    - ConexionBD()
    + AbrirConexion() : SqlConnection
  }
}

package "ec.edu.monster.modelo" {
  class Empleado <<DataContract>> {
    Codigo, Usuario, Nombre
  }
  class Cuenta <<DataContract>> {
    Codigo, Cliente, Moneda, Sucursal,
    Saldo, Estado, FechaCreacion, NumeroMovimientos
  }
  class Movimiento <<DataContract>> {
    Numero, Fecha, Tipo, Accion,
    Importe, Empleado, CuentaReferencia
  }
  class ErrorServicio <<DataContract>> {
    Codigo, Mensaje
  }
}

WSEureka ..|> IWSEureka
WSEureka --> EurekaServicio : Instancia
EurekaServicio --> ConexionBD : Instancia
EurekaServicio ..> Validacion
EurekaServicio ..> ReglaNegocioException
EurekaServicio ..> Cuenta
EurekaServicio ..> Movimiento
EurekaServicio ..> Empleado
WSEureka ..> ErrorServicio
@enduml
