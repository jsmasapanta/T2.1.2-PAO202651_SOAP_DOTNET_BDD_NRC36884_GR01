@startuml DS_Consultar_Movimientos
!include ../_estilo.iuml
title Diagrama de secuencia — CU02 Consultar cuenta y movimientos
autonumber

actor Empleado
participant "vista\n(PanelMovimientos / Movimientos.cshtml /\nMovimientosPage)" as Vista
participant "controlador" as Ctrl
participant "servicio\nClienteEureka (Singleton)" as Proxy
participant "ws\nWSEureka.svc" as WS
participant "servicio\nEurekaServicio" as Neg
database "SQL Server\nEUREKABANK" as SQL

Empleado -> Vista : número de cuenta, Consultar
Vista -> Ctrl : EsCuentaValida(cuenta)
alt no tiene 8 dígitos
  Ctrl --> Vista : false
  Vista --> Empleado : «La cuenta debe tener 8 dígitos»
else formato correcto
  Vista -> Ctrl : Consultar(cuenta)
  Ctrl -> Proxy : ConsultarCuenta(cuenta)
  Proxy -> WS : POST SOAP <consultarCuenta>
  WS -> Neg : ConsultarCuenta(cuenta)
  Neg -> SQL : SELECT Cuenta JOIN Cliente, Moneda, Sucursal
  alt la cuenta existe
    Neg --> WS : Cuenta
    WS --> Proxy : <consultarCuentaResult>
    Ctrl -> Proxy : TraerMovimientos(cuenta)
    Proxy -> WS : POST SOAP <traerMovimientos>
    WS -> Neg : TraerMovimientos(cuenta)
    Neg -> SQL : SELECT Movimiento JOIN TipoMovimiento\nORDER BY int_movinumero DESC
    Neg --> WS : List<Movimiento>
    WS --> Proxy : <traerMovimientosResult>
    Proxy --> Ctrl : Cuenta + Movimiento[]
    Ctrl --> Vista : datos
    Vista --> Empleado : cliente, moneda, saldo y tabla de movimientos
  else no existe
    WS --> Proxy : SOAP Fault REGLA_NEGOCIO «La cuenta … no existe.»
    Proxy --> Ctrl : ErrorServicioException
    Ctrl --> Vista : mensaje
    Vista --> Empleado : mensaje en rojo
  end
end
@enduml
