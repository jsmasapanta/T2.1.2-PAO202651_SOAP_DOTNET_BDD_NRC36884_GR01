<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <!-- maxReceivedMessageSize: una cuenta con muchos movimientos supera los 64 KB por defecto. -->
        <binding name="EurekaBinding" openTimeout="00:00:10" sendTimeout="00:00:30" receiveTimeout="00:00:30"
                 maxReceivedMessageSize="10485760" />
      </basicHttpBinding>
    </bindings>
    <client>
      <!-- Cambiar SOLO esta dirección para apuntar a otro servidor (por ejemplo http://192.168.1.10:8087/WSEureka.svc). -->
      <endpoint name="WSEureka"
                address="http://192.168.100.3:8087/WSEureka.svc"
                binding="basicHttpBinding"
                bindingConfiguration="EurekaBinding"
                contract="ec.edu.monster.servicio.IWSEureka" />
    </client>
  </system.serviceModel>
</configuration>
